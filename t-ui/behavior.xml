<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<behavior>
    <!-- User & Device Info -->
    <username value="josel"/>
    <deviceName value="reno5"/>
    <home_path value="/storage/emulated/0"/>
    <input_prefix value="➜"/>
    
    <!-- Battery Thresholds -->
    <battery_medium value="50"/>
    <battery_low value="20"/>
    
    <!-- General Behavior, Counters & Session Info -->
    <clear_on_lock value="false"/>
    <enable_app_launch value="true"/>
    <show_alias_context value="false"/>
    <show_unlock_counter value="false"/>
    <show_session_info value="false"/>
    <session_info_format value=""/>
    
    <!-- Nushell Table Structure (Vanilla Pure ASCII Labels: 28-char Collinear Matrix) -->
    <device_format value=""/>
    
    <!-- Row 0, 1 + Table Header (ram_color: #B4BEFE) -->
    <ram_format value="╭──────────┬───────────────╮%n│ metric   │ value         │%n├──────────┼───────────────┤%n│ host     │ josel@reno5   │%n│ memory   │ %avgbG / %totgbG │"/>
    
    <!-- Row 2: Battery (battery_color_*: #A6E3A1) -->
    <battery_format value="│ battery  │ %v%           │"/>
    
    <!-- Row 3: Timestamp (time_color: #89B4FA) -->
    <time_format value="'│ time     │ 'd MMM, HH:mm' │'"/>
    
    <!-- Row 4: Storage (storage_color: #CBA6F7) -->
    <storage_format value="│ storage  │ %iavgbG/%itotgbG│"/>
    
    <!-- Row 5 & 6: WiFi, Mobile Data & Bottom Border (network_info_color: #EBA0AC) -->
    <network_info_format value="│ wifi     │ %(ON/OFF)            │%n│ data     │ %[ON/OFF]            │%n╰──────────┴───────────────╯"/>
    
    <!-- Notes Format -->
    <notes_format value="│ note     │ %n           │"/>
    
    <!-- Session / History Prompt Format -->
    <session_format value="➜ "/>
    <app_launch_format value="Starting %p..."/>
</behavior>
