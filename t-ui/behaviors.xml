<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<behavior>
    <!-- User & Device Info -->
    <username value="josel"/>
    <deviceName value="reno5"/>
    <home_path value="/storage/emulated/0"/>
    <input_prefix value="➜ "/>
    
    <!-- Battery Thresholds -->
    <battery_medium value="50"/>
    <battery_low value="20"/>
    
    <!-- General Behavior -->
    <clear_on_lock value="false"/>
    <enable_app_launch value="true"/>
    <show_alias_context value="false"/>
    
    <!-- Nushell Table Structure (Exact 29-char width: Perfect Alignment) -->
    <!-- Row 0 + Table Header (device_color) -->
    <device_format value="╭──────────┬────────────────╮%n│ metric   │ value          │%n├──────────┼────────────────┤%n│ ◆ host    │ %u@%d    │"/>
    
    <!-- Row 1: Memory (ram_color) -->
    <ram_format value="│ ≡ memory  │ %avgbG / %totgbG │"/>
    
    <!-- Row 2: Battery (battery_color_*) -->
    <battery_format value="│ ↯ battery │ %v% %(⚡/ )         │"/>
    
    <!-- Row 3: Timestamp (time_color) -->
    <time_format value="'│ ◷ time    │ 'd MMM, HH:mm'   │'"/>
    
    <!-- Row 4: Storage (storage_color) -->
    <storage_format value="│ ▤ storage │ %iavgbG/%itotgbG │"/>
    
    <!-- Row 5 & 6: WiFi, Mobile Data & Bottom Border (network_info_color) -->
    <network_info_format value="│ ᯤ wifi    │ %(ON             /OFF            )│%n│ ⇅ data    │ %[ON             /OFF            ]│%n╰──────────┴────────────────╯"/>
    
    <!-- Notes Format -->
    <notes_format value="│ ▧ note    │ %n           │"/>
    
    <!-- Session / History Prompt Format (Clean prompt without table bleeding) -->
    <session_format value="➜ "/>
    <app_launch_format value="Starting %p..."/>
</behavior>
