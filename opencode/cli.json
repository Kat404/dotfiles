{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "plugins": [
    "/home/josel/.config/opencode/tui-plugins/gentle-logo.tsx"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd",
    "enabled": true
  },
  "scroll": {
    "acceleration": false
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "title": true
  }
}
