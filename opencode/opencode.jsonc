{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MiniMax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "MINIMAX_API_KEY",
        "MINIMAX_API_HOST": "https://api.minimax.io"
      },
      "enabled": true
    },
    "engram": {
      "command": [
        "/home/josel/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],
  "agent": {
    "build": { "mode": "primary" },
    "plan": { "mode": "primary" },
    "chart": { "mode": "primary" },
    "craft": { "mode": "primary" }
  }
}